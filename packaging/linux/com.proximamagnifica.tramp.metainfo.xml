<?xml version="1.0" encoding="UTF-8"?>
<!-- The display name every Linux installer shows. Without this file flatpak,
     GNOME Software and Discover have no name to read and fall back to the app
     ID, so the app installs as "com.proximamagnifica.tramp". -->
<component type="desktop-application">
  <id>com.proximamagnifica.tramp</id>

  <name>Tramp</name>
  <summary>Play your local music files</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="com.proximamagnifica">
    <name>Proxima Magnifica</name>
  </developer>

  <description>
    <p>
      Tramp is a music player for the files you already have. Open tracks and
      playlists from the file picker, drop them on the window, or hand them over
      from a file manager. There is no library to import and no account to make.
    </p>
    <p>
      The playlist is the whole model: add, remove and reorder tracks, save them
      as M3U or M3U8, and pick up where you left off next time. Transport chrome
      shows the tags a file carries, a twenty-bar spectrum analyser follows what
      is playing, and a ten-band equaliser with presets sits beside it.
    </p>
    <p>
      The window is Tramp's own, painted rather than themed, and it can be
      recoloured with skins you install from a folder or a zip.
    </p>
  </description>

  <launchable type="desktop-id">com.proximamagnifica.tramp.desktop</launchable>

  <!-- Empty means checked and nothing to declare, which is not the same as absent. -->
  <content_rating type="oars-1.1" />

  <url type="homepage">https://tramp.music</url>

  <!-- Flathub requires screenshots, and <image> has to be a URL it can fetch, so
       there is no way to ship them inside the bundle. The pictures are generated
       rather than committed: run the dump-chrome flag and take
       main_player_window.png, playlist_window.png and equalizer_window.png.
       Upload them under the path below, then uncomment. The check-urls flag on
       check-metainfo.sh starts verifying them from that point on, and fails a
       release if one stops resolving.
  <screenshots>
    <screenshot type="default">
      <image>https://tramp.music/screenshots/0.1.0/main_player_window.png</image>
      <caption>Transport chrome, tags and the spectrum analyser</caption>
    </screenshot>
    <screenshot>
      <image>https://tramp.music/screenshots/0.1.0/playlist_window.png</image>
      <caption>The playlist manager</caption>
    </screenshot>
    <screenshot>
      <image>https://tramp.music/screenshots/0.1.0/equalizer_window.png</image>
      <caption>Ten-band equaliser with presets</caption>
    </screenshot>
  </screenshots>
  -->

  <!-- Newest first: out-of-order entries fail validation. tool/version.sh and the
       release workflow check the top version against the VERSION file. -->
  <releases>
    <release version="0.1.0" date="2026-08-24">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
